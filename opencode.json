{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-readseek",
    "@dietrichgebert/ponytail"
  ],
  "mcp": {
    "cavemem": {
      "type": "local",
      "command": [
        "cavemem",
        "mcp"
      ],
      "enabled": true
    },
    "yggdrasil": {
      "type": "remote",
      "url": "https://yggdrasil-api.gruppe.ai/mcp",
      "enabled": true,
      "oauth": {
        "clientId": "yggdrasil-mcp",
        "scope": "openid profile",
        "callbackPort": 19876,
        "redirectUri": "http://127.0.0.1:19876/mcp/oauth/callback"
      }
    }
  },
  "permission": {
    "bash": {
      "uv *": "allow",
      "ruff *": "allow"
    }
  }
}
